# Modelo de variáveis da stack. Copie para .env (desenvolvimento) ou cadastre na stack do Portainer.
# Nunca commite valores reais: chaves do Stripe, senhas e segredos ficam só no .env / Portainer.

# ---- Banco de dados (MySQL/MariaDB) ----
DATABASE_URL=mysql://usuario:senha@host:3306/kreato
DATABASE_HOST=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_PORT=3306

# ---- Autenticação ----
JWT_SECRET=
# Cookie da sessão só por HTTPS (true em produção atrás de TLS)
COOKIE_SECURE=

# ---- Ambiente e rede ----
NODE_ENV=production
KREATO_PORT=8209
KREATO_SUBNET=
# URL pública do frontend (links de e-mail e retorno do Stripe)
FRONTEND_URL=
VITE_API_BASE_URL=/api
# Proxies confiáveis para o IP real (vazio = redes privadas)
TRUST_PROXY=
# Origens extras liberadas no CORS, separadas por vírgula (vazio = só o mesmo domínio)
CORS_ORIGINS=
# Swagger em produção (true/false)
ENABLE_API_DOCS=false

# ---- E-mail (Brevo tem prioridade; depois Mailtrap) ----
EMAIL_PROVIDER=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
MAILTRAP_TOKEN=
MAILTRAP_SENDER_EMAIL=

# ---- MinIO (anexos e avatares) ----
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=avatars

# ---- Stripe (modo de teste: sk_test_..., pk_test_..., whsec_...) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Segredo do endpoint de webhook (/api/stripe/webhook) cadastrado no painel do Stripe
STRIPE_WEBHOOK_SECRET=
# Price IDs dos preços recorrentes mensais em BRL (price_...)
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# Legado: Price ID do Creator, usado se STRIPE_PRICE_CREATOR estiver vazio
STRIPE_PRICE_ID=
