generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  nome                 String   @db.VarChar(100)
  email                String   @unique @db.VarChar(150)
  senhaHash            String   @db.VarChar(255)
  role                 String   @default("creator") @db.VarChar(20)
  plano                String   @default("FREE") @db.VarChar(20)
  stripeCustomerId     String?  @db.VarChar(255)
  stripeSubscriptionId String?  @db.VarChar(255)
  /// Cópia do status da assinatura no Stripe (active, past_due, canceled...), mantida pelos webhooks
  statusAssinatura     String?  @db.VarChar(30)
  /// Valor mensal da assinatura em centavos de BRL (base do MRR do painel admin)
  valorMensalCentavos  Int?
  bio                  String?  @db.Text
  fotoPerfil           String?  @db.Text
  criadoEm             DateTime @default(now())

  refreshTokens         RefreshToken[]
  resetTokens           ResetToken[]
  workspacesDono        Workspace[]          @relation("WorkspaceDono")
  participacoes         MembroWorkspace[]
  ideias                Ideia[]
  conteudos             Conteudo[]
  anexos                Anexo[]
  metricas              Metrica[]
  convitesEnviados      Convite[]            @relation("ConviteRemetente")
  convitesAceitos       Convite[]            @relation("ConviteAceitoPor")
  roteirosAprovados     Conteudo[]           @relation("RoteiroAprovadoPor")
  comentarios           ComentarioConteudo[] @relation("ComentarioAutor")
  comentariosResolvidos ComentarioConteudo[] @relation("ComentarioResolvidoPor")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(255)
  usuarioId String   @db.VarChar(36)
  expiresAt DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model ResetToken {
  token     String   @id @default(uuid()) @db.VarChar(36)
  usuarioId String   @db.VarChar(36)
  expiresAt DateTime
  criadoEm  DateTime @default(now())
  usado     Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  nome               String   @db.VarChar(100)
  donoId             String   @db.VarChar(36)
  // Preenchido apenas no workspace pessoal (= donoId), garantindo um único por usuário
  pessoalDoUsuarioId String?  @unique @db.VarChar(36)
  // Meta de publicações por semana (segunda a domingo), usada na sequência do dashboard
  metaSemanal        Int      @default(3)
  criadoEm           DateTime @default(now())

  dono        Usuario              @relation("WorkspaceDono", fields: [donoId], references: [id], onDelete: Cascade)
  membros     MembroWorkspace[]
  ideias      Ideia[]
  conteudos   Conteudo[]
  anexos      Anexo[]
  metricas    Metrica[]
  convites    Convite[]
  comentarios ComentarioConteudo[]

  @@index([donoId])
}

model MembroWorkspace {
  id          Int      @id @default(autoincrement())
  workspaceId String   @db.VarChar(36)
  usuarioId   String   @db.VarChar(36)
  papel       String   @default("EDITOR") @db.VarChar(20)
  criadoEm    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, usuarioId])
  @@index([usuarioId])
}

model Ideia {
  id           Int      @id @default(autoincrement())
  workspaceId  String   @db.VarChar(36)
  autorId      String?  @db.VarChar(36)
  titulo       String   @db.VarChar(150)
  gancho       String?  @db.Text
  descricao    String?  @db.Text
  legenda      String?  @db.Text
  plataforma   String?  @db.VarChar(20)
  // Lista de strings normalizadas (minúsculas, sem duplicatas)
  tags         Json?
  status       String   @default("NOVA") @db.VarChar(30)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation(fields: [autorId], references: [id], onDelete: SetNull)
  conteudo  Conteudo?

  @@index([workspaceId, status])
  @@index([autorId])
}

model Conteudo {
  id                   Int       @id @default(autoincrement())
  workspaceId          String    @db.VarChar(36)
  autorId              String?   @db.VarChar(36)
  // Ideia de origem: cada ideia pode ser convertida em no máximo um conteúdo
  ideiaId              Int?      @unique
  titulo               String    @db.VarChar(150)
  // IDEIA → ROTEIRO → GRAVACAO → EDICAO → AGENDADO → PUBLICADO
  etapa                String    @default("IDEIA") @db.VarChar(20)
  // Ordem do card dentro da coluna (etapa) do kanban
  posicao              Int       @default(0)
  roteiro              String?   @db.Text
  legenda              String?   @db.Text
  // Lista de hashtags normalizadas, sem "#"
  hashtags             Json?
  plataforma           String?   @db.VarChar(20)
  formato              String?   @db.VarChar(20)
  dataPublicacao       DateTime?
  urlPublicacao        String?   @db.VarChar(500)
  // Aprovação do roteiro (ROTEIRO -> GRAVACAO por DONO/GESTOR); limpa ao voltar para roteiro
  roteiroAprovadoEm    DateTime?
  roteiroAprovadoPorId String?   @db.VarChar(36)
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor              Usuario?             @relation(fields: [autorId], references: [id], onDelete: SetNull)
  roteiroAprovadoPor Usuario?             @relation("RoteiroAprovadoPor", fields: [roteiroAprovadoPorId], references: [id], onDelete: SetNull)
  ideia              Ideia?               @relation(fields: [ideiaId], references: [id], onDelete: SetNull)
  anexos             Anexo[]
  metricas           Metrica[]
  comentarios        ComentarioConteudo[]

  @@index([workspaceId, etapa, posicao])
  @@index([workspaceId, dataPublicacao])
  @@index([autorId])
  @@index([roteiroAprovadoPorId])
}

model Anexo {
  id           Int      @id @default(autoincrement())
  conteudoId   Int
  // Redundante com o conteúdo, mas permite somar o armazenamento usado pelo workspace sem join
  workspaceId  String   @db.VarChar(36)
  autorId      String?  @db.VarChar(36)
  nomeOriginal String   @db.VarChar(255)
  // Chave do objeto no bucket de assets do MinIO
  chave        String   @unique @db.VarChar(255)
  tipoMime     String   @db.VarChar(150)
  tamanhoBytes Int
  criadoEm     DateTime @default(now())

  conteudo  Conteudo  @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([conteudoId])
  @@index([workspaceId])
  @@index([autorId])
}

// Foto dos números de um conteúdo publicado em um momento (registro manual por enquanto)
model Metrica {
  id                Int      @id @default(autoincrement())
  conteudoId        Int
  workspaceId       String   @db.VarChar(36)
  registradoPorId   String?  @db.VarChar(36)
  // Quando os números foram observados na plataforma
  coletadoEm        DateTime @default(now())
  visualizacoes     Int      @default(0)
  curtidas          Int      @default(0)
  comentarios       Int      @default(0)
  compartilhamentos Int      @default(0)
  salvamentos       Int      @default(0)
  alcance           Int?
  seguidoresGanhos  Int?
  criadoEm          DateTime @default(now())

  conteudo      Conteudo  @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  registradoPor Usuario?  @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([conteudoId, coletadoEm])
  @@index([workspaceId, coletadoEm])
  @@index([registradoPorId])
}

/// Convite para entrar em um workspace (plano Studio). Só o hash do token fica no banco.
model Convite {
  id             Int       @id @default(autoincrement())
  workspaceId    String    @db.VarChar(36)
  email          String    @db.VarChar(150)
  papel          String    @default("EDITOR") @db.VarChar(20)
  // SHA-256 (hex) do token enviado no link
  tokenHash      String    @unique @db.VarChar(64)
  // PENDENTE, ACEITO ou REVOGADO (expirado = PENDENTE com expiraEm no passado)
  status         String    @default("PENDENTE") @db.VarChar(20)
  expiraEm       DateTime
  convidadoPorId String?   @db.VarChar(36)
  aceitoPorId    String?   @db.VarChar(36)
  aceitoEm       DateTime?
  criadoEm       DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  convidadoPor Usuario?  @relation("ConviteRemetente", fields: [convidadoPorId], references: [id], onDelete: SetNull)
  aceitoPor    Usuario?  @relation("ConviteAceitoPor", fields: [aceitoPorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([convidadoPorId])
  @@index([aceitoPorId])
}

/// Comentários de revisão de um conteúdo (inclui registros de aprovação e pedidos de ajuste)
model ComentarioConteudo {
  id             Int       @id @default(autoincrement())
  conteudoId     Int
  workspaceId    String    @db.VarChar(36)
  autorId        String?   @db.VarChar(36)
  texto          String    @db.Text
  // COMENTARIO, APROVACAO ou AJUSTE
  tipo           String    @default("COMENTARIO") @db.VarChar(20)
  // Etapa do conteúdo quando o comentário foi feito
  etapa          String    @db.VarChar(20)
  resolvido      Boolean   @default(false)
  resolvidoPorId String?   @db.VarChar(36)
  resolvidoEm    DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  conteudo     Conteudo  @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor        Usuario?  @relation("ComentarioAutor", fields: [autorId], references: [id], onDelete: SetNull)
  resolvidoPor Usuario?  @relation("ComentarioResolvidoPor", fields: [resolvidoPorId], references: [id], onDelete: SetNull)

  @@index([conteudoId, criadoEm])
  @@index([workspaceId])
  @@index([autorId])
  @@index([resolvidoPorId])
}

/// Eventos do Stripe já processados: o mesmo evento reenviado não é aplicado de novo
model StripeEvento {
  id          String   @id @db.VarChar(255)
  tipo        String   @db.VarChar(100)
  processadoEm DateTime @default(now())
}
