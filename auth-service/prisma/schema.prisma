generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  nome                 String   @db.VarChar(100)
  email                String   @unique @db.VarChar(150)
  senhaHash            String   @db.VarChar(255)
  role                 String   @default("creator") @db.VarChar(20)
  plano                String   @default("FREE") @db.VarChar(20)
  stripeCustomerId     String?  @db.VarChar(255)
  stripeSubscriptionId String?  @db.VarChar(255)
  bio                  String?  @db.Text
  fotoPerfil           String?  @db.Text
  criadoEm             DateTime @default(now())

  refreshTokens  RefreshToken[]
  resetTokens    ResetToken[]
  workspacesDono Workspace[]       @relation("WorkspaceDono")
  participacoes  MembroWorkspace[]
  ideias         Ideia[]
  conteudos      Conteudo[]
  anexos         Anexo[]
  metricas       Metrica[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(255)
  usuarioId String   @db.VarChar(36)
  expiresAt DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model ResetToken {
  token     String   @id @default(uuid()) @db.VarChar(36)
  usuarioId String   @db.VarChar(36)
  expiresAt DateTime
  criadoEm  DateTime @default(now())
  usado     Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  nome               String   @db.VarChar(100)
  donoId             String   @db.VarChar(36)
  // Preenchido apenas no workspace pessoal (= donoId), garantindo um único por usuário
  pessoalDoUsuarioId String?  @unique @db.VarChar(36)
  criadoEm           DateTime @default(now())

  dono      Usuario           @relation("WorkspaceDono", fields: [donoId], references: [id], onDelete: Cascade)
  membros   MembroWorkspace[]
  ideias    Ideia[]
  conteudos Conteudo[]
  anexos    Anexo[]
  metricas  Metrica[]

  @@index([donoId])
}

model MembroWorkspace {
  id          Int      @id @default(autoincrement())
  workspaceId String   @db.VarChar(36)
  usuarioId   String   @db.VarChar(36)
  papel       String   @default("EDITOR") @db.VarChar(20)
  criadoEm    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, usuarioId])
  @@index([usuarioId])
}

model Ideia {
  id           Int      @id @default(autoincrement())
  workspaceId  String   @db.VarChar(36)
  autorId      String?  @db.VarChar(36)
  titulo       String   @db.VarChar(150)
  gancho       String?  @db.Text
  descricao    String?  @db.Text
  legenda      String?  @db.Text
  plataforma   String?  @db.VarChar(20)
  // Lista de strings normalizadas (minúsculas, sem duplicatas)
  tags         Json?
  status       String   @default("NOVA") @db.VarChar(30)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation(fields: [autorId], references: [id], onDelete: SetNull)
  conteudo  Conteudo?

  @@index([workspaceId, status])
  @@index([autorId])
}

model Conteudo {
  id             Int       @id @default(autoincrement())
  workspaceId    String    @db.VarChar(36)
  autorId        String?   @db.VarChar(36)
  // Ideia de origem: cada ideia pode ser convertida em no máximo um conteúdo
  ideiaId        Int?      @unique
  titulo         String    @db.VarChar(150)
  // IDEIA → ROTEIRO → GRAVACAO → EDICAO → AGENDADO → PUBLICADO
  etapa          String    @default("IDEIA") @db.VarChar(20)
  // Ordem do card dentro da coluna (etapa) do kanban
  posicao        Int       @default(0)
  roteiro        String?   @db.Text
  legenda        String?   @db.Text
  // Lista de hashtags normalizadas, sem "#"
  hashtags       Json?
  plataforma     String?   @db.VarChar(20)
  formato        String?   @db.VarChar(20)
  dataPublicacao DateTime?
  urlPublicacao  String?   @db.VarChar(500)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation(fields: [autorId], references: [id], onDelete: SetNull)
  ideia     Ideia?    @relation(fields: [ideiaId], references: [id], onDelete: SetNull)
  anexos    Anexo[]
  metricas  Metrica[]

  @@index([workspaceId, etapa, posicao])
  @@index([workspaceId, dataPublicacao])
  @@index([autorId])
}

model Anexo {
  id           Int      @id @default(autoincrement())
  conteudoId   Int
  // Redundante com o conteúdo, mas permite somar o armazenamento usado pelo workspace sem join
  workspaceId  String   @db.VarChar(36)
  autorId      String?  @db.VarChar(36)
  nomeOriginal String   @db.VarChar(255)
  // Chave do objeto no bucket de assets do MinIO
  chave        String   @unique @db.VarChar(255)
  tipoMime     String   @db.VarChar(150)
  tamanhoBytes Int
  criadoEm     DateTime @default(now())

  conteudo  Conteudo  @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([conteudoId])
  @@index([workspaceId])
  @@index([autorId])
}

// Foto dos números de um conteúdo publicado em um momento (registro manual por enquanto)
model Metrica {
  id                Int      @id @default(autoincrement())
  conteudoId        Int
  workspaceId       String   @db.VarChar(36)
  registradoPorId   String?  @db.VarChar(36)
  // Quando os números foram observados na plataforma
  coletadoEm        DateTime @default(now())
  visualizacoes     Int      @default(0)
  curtidas          Int      @default(0)
  comentarios       Int      @default(0)
  compartilhamentos Int      @default(0)
  salvamentos       Int      @default(0)
  alcance           Int?
  seguidoresGanhos  Int?
  criadoEm          DateTime @default(now())

  conteudo      Conteudo  @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  registradoPor Usuario?  @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([conteudoId, coletadoEm])
  @@index([workspaceId, coletadoEm])
  @@index([registradoPorId])
}
